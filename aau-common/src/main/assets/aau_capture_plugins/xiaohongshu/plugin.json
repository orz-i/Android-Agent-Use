{
  "id": "xiaohongshu",
  "apiVersion": 1,
  "version": 2,
  "declaration": {
    "name": "小红书",
    "summary": "绑定 libcronet 114 的固定偏移，按 edith.xiaohongshu.com 补全域名。",
    "author": "Mika",
    "notes": [
      "SSL_write / SSL_read / SNI 固定偏移（libcronet 114.0.5735.38）",
      "Cronet 四段回调偏移：构造、响应开始、读完成、成功",
      "把 /api/sns/ 请求的 Host 补成 edith.xiaohongshu.com"
    ]
  },
  "packages": ["com.xingin.xhs"],
  "hostFix": {
    "headerPriority": [":authority", "host"],
    "defaultHost": "edith.xiaohongshu.com",
    "defaultHostPathContains": "/api/sns/",
    "onRequest": false
  },
  "ebpfProfile": {
    "sslOffsetRules": [
      {
        "libSubstring": "libcronet.114.0.5735.38.so",
        "writeOffset": "0x4ea720",
        "readOffset": "0x4ea438",
        "sniOffset": "0x4eb0c8"
      }
    ],
    "cronetOffsetRules": [
      {
        "libSubstring": "libcronet.114.0.5735.38.so",
        "createOffset": "0x226c34",
        "responseStartedOffset": "0x206dd4",
        "readCompletedOffset": "0x206f34",
        "succeededOffset": "0x206ffc"
      }
    ],
    "cronetAbiRule": {
      "rawHeadersOffset": "0x20",
      "ioBufferDataOffset": "0x10",
      "stringLayoutMode": 0,
      "vtableSlots": [3, 4, 5],
      "jniSignatures": ["(Ljava/lang/Object;JLjava/lang/String;IZZZIZIIJ)J"]
    }
  }
}
